# Environment Profile
ENVIRONMENT=development
LOG_LEVEL=INFO

# Networking & Ports
BACKEND_PORT=8010
FRONTEND_PORT=5174
POSTGRES_PORT=5432
REDIS_PORT=6379

# Native PostgreSQL Connection (Linux system service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=fleet_admin
POSTGRES_PASSWORD=fleet_secure_pass
POSTGRES_DB=fleet_control_tower_db

# Native Redis Connection (Linux system service)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Security Tokens
JWT_SECRET_KEY=super_secret_jwt_key_change_in_production_32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
