import { env } from '../config/env';
import React, { useEffect, useState } from 'react';
import { Menu, LogOut, User, CheckCircle2, Eye } from 'lucide-react';
import { useAuthStore } from '../store/auth';
import { usePermissions } from '../hooks/usePermissions';

interface HeaderProps {
  onToggleMobileMenu?: () => void;
}

export const Header: React.FC<HeaderProps> = ({ onToggleMobileMenu }) => {
  const { user, clearAuth } = useAuthStore();
  const { isSuperuser, activeSectionsCount } = usePermissions();
  const [timeStr, setTimeStr] = useState(() => new Date().toLocaleTimeString());

  useEffect(() => {
    const timer = setInterval(() => setTimeStr(new Date().toLocaleTimeString()), 1000);
    return () => clearInterval(timer);
  }, []);

  const handleLogout = async () => {
    try {
      await fetch(env.VITE_API_BASE_URL + '/auth/logout', { method: 'POST' });
    } catch (e) {
      // Ignore network errors on logout
    }
    clearAuth();
    localStorage.removeItem('fct_auth_token');
    localStorage.removeItem('token');
    localStorage.removeItem('fct_auth_user');
    window.location.href = '/login';
  };

  return (
    <header
      className="h-14 md:h-12 border-b flex items-center justify-between px-4 shrink-0 z-30 shadow-xs"
      style={{ backgroundColor: '#FBFCFE', borderColor: '#DCE2EA', color: '#172033' }}
    >
      <div className="flex items-center gap-3">
        {/* Mobile Hamburger Toggle Button */}
        <button
          type="button"
          onClick={onToggleMobileMenu}
          className="p-2 rounded-lg text-slate-500 hover:text-slate-900 hover:bg-slate-100 md:hidden min-h-[44px] min-w-[44px] flex items-center justify-center"
          title="Open Navigation Menu"
        >
          <Menu className="w-5 h-5" />
        </button>

        <div className="text-xs md:text-sm font-bold tracking-tight truncate" style={{ color: '#172033' }}>
          Fleet Control Tower <span className="font-normal hidden sm:inline" style={{ color: '#64748B' }}>| Ready Mix Concrete</span>
        </div>
      </div>

      <div className="flex items-center gap-3 md:gap-4 text-xs">
        <span className="hidden lg:inline font-mono text-[11px] font-medium" style={{ color: '#64748B' }}>Last Updated: {timeStr}</span>
        
        {/* Dynamic Persona & Permission Scope Indicator */}
        {isSuperuser ? (
          <span className="hidden md:inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-200 shadow-2xs">
            Superuser
          </span>
        ) : activeSectionsCount.edit >= 14 ? (
          <span className="hidden md:inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 shadow-2xs">
            Full Access
          </span>
        ) : activeSectionsCount.edit > 0 ? (
          <span
            className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200 shadow-2xs"
            title={`Operator Account: ${activeSectionsCount.edit} Edit, ${activeSectionsCount.view} View permissions active`}
          >
            <CheckCircle2 className="w-3 h-3 text-blue-600" />
            <span>Operator</span>
          </span>
        ) : (
          <span
            className="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200 shadow-2xs"
            title="Read-Only Account: Viewing permissions only"
          >
            <Eye className="w-3 h-3 text-slate-500" />
            <span>View Only</span>
          </span>
        )}

        <div className="flex items-center gap-2">
          <span className="px-2.5 py-1 rounded-md font-semibold text-[11px] flex items-center gap-1.5" style={{ backgroundColor: '#F1F5F9', color: '#1E293B', border: '1px solid #CBD5E1' }}>
            <User className="w-3.5 h-3.5" style={{ color: '#475569' }} />
            <span className="hidden sm:inline">
              {user ? (user.username || (typeof user.sub === 'string' ? user.sub.slice(0, 8) : 'Admin')) : 'Admin Operator'}
            </span>
          </span>
          <button
            onClick={handleLogout}
            className="px-2.5 py-1 rounded-md text-[11px] font-semibold flex items-center gap-1 min-h-[36px] sm:min-h-[28px] transition hover:bg-slate-200"
            style={{ backgroundColor: '#F8FAFC', borderColor: '#CBD5E1', color: '#334155', border: '1px solid #CBD5E1' }}
          >
            <LogOut className="w-3.5 h-3.5" />
            <span>Logout</span>
          </button>
        </div>
      </div>
    </header>
  );
};
